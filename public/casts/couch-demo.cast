{"captions":[{"start":0.408,"end":4.837,"text":"start up couch loads the \"slot\" you started from, here it's \"brain\""},{"start":4.871,"end":8.871,"text":"then in parallel, loading other \"live slots\"."},{"start":9.741,"end":13.741,"text":"click on tab bar to switch tab"},{"start":13.741,"end":17.741,"text":"use switcher to find workspace slot you are looking for"},{"start":18.154,"end":22.154,"text":"focused view of what's going on in active slots"},{"start":22.639,"end":26.639,"text":"programs running in the tabs are still running after restart"},{"start":27.197,"end":31.197,"text":"start to broadcast, by default in viewer mode"},{"start":31.989,"end":36.418,"text":"click on the hand icon for allowing viewer to point at things"},{"start":37.472,"end":43.9,"text":"viewer loaded in browser, and they can things they have questions on. browser view clones this terminal view verbatim."},{"start":44.913,"end":48.913,"text":"click on LIVE ⏸ to stop broadcasting"},{"start":48.913,"end":52.913,"text":"quit but leave agents running"}],"command":"couch","env":{"SHELL":"/bin/zsh"},"term":{"cols":191,"rows":54,"type":"xterm-ghostty","version":"ghostty 1.3.1","theme":{"fg":"#ffffff","bg":"#1e1e1e","palette":"#1a1a1a:#cc372e:#26a439:#cdac08:#0869cb:#9647bf:#479ec2:#98989d:#464646:#ff453a:#32d74b:#ffd60a:#0a84ff:#bf5af2:#76d6ff:#ffffff"}},"timestamp":1791495715,"version":3}
