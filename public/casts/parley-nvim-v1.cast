{"version": 3, "term": {"cols": 95, "rows": 36, "type": "xterm-ghostty", "version": "ghostty 1.3.1", "theme": {"fg": "#ffffff", "bg": "#1e1e1e", "palette": "#1a1a1a:#cc372e:#26a439:#cdac08:#0869cb:#9647bf:#479ec2:#98989d:#464646:#ff453a:#32d74b:#ffd60a:#0a84ff:#bf5af2:#76d6ff:#ffffff"}}, "timestamp": 1790713580, "env": {"SHELL": "/bin/zsh"}, "captions": [{"start": 0.823, "end": 3.823, "text": "install plugin."}, {"start": 4.155, "end": 7.155, "text": "now you can ask questions"}, {"start": 8.86, "end": 11.86, "text": "configure an AI provider"}, {"start": 12.178, "end": 15.178, "text": "a browser opens up for authentication."}, {"start": 15.694, "end": 18.694, "text": "select a model"}, {"start": 20.228, "end": 23.228, "text": "now the AI is doing its magic..."}, {"start": 26.714, "end": 29.714, "text": "ask question in a chat branch"}, {"start": 31.861, "end": 34.861, "text": "auto completion makes typing easier"}, {"start": 34.861, "end": 40.432, "text": "you can tag anywhere in the document on a new line. and it shows in outline"}, {"start": 40.787, "end": 43.787, "text": "navigate away while waiting for answer"}, {"start": 45.771, "end": 48.771, "text": "ask other questions"}, {"start": 55.55, "end": 58.55, "text": "jump to another thread."}, {"start": 59.208, "end": 62.208, "text": "and read about sun synchronous orbit"}, {"start": 63.959, "end": 66.959, "text": "you can make private notes"}, {"start": 73.194, "end": 76.194, "text": "make more notes as you go"}, {"start": 82.115, "end": 85.115, "text": "ask more questions"}, {"start": 93.688, "end": 96.688, "text": "maintain the outline for easy navigation"}, {"start": 97.005, "end": 100.005, "text": "read about AI's response about china"}, {"start": 103.494, "end": 106.494, "text": "ask next question in the main thread."}, {"start": 112.194, "end": 115.194, "text": "undo/redo supported in question/answers."}, {"start": 116.273, "end": 119.273, "text": "you can search for chats."}, {"start": 120.496, "end": 124.925, "text": "update the topic of a chat, and the file will be renamed"}]}
